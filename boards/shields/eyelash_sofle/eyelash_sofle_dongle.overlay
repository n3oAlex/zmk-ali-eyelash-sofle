/*
 * Dongle: the seller's custom nRF52840 board (nice!nano v2 compatible pin
 * numbering and bootloader) with a 1.3" 128x64 I2C OLED, a battery, a power
 * switch and a reset button. No keys of its own, so the key scan is a mock;
 * the layout and transform come from the shared dtsi so key positions sent by
 * the halves map onto the keymap.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/led/led.h>
#include "eyelash_sofle.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,display = &oled;
        zmk,underglow = &led_strip;
    };

    mock_kscan: kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

/*
 * OLED I2C pins: SDA = P0.17 (a 0-ohm jumper next to the "SDA" silkscreen
 * selects P0.17; P0.21 is the unpopulated alternative), SCL = P0.20. These are
 * the nice!nano defaults, kept explicit so the routing is documented here.
 */
&pinctrl {
    dongle_i2c_default: dongle_i2c_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };

    dongle_i2c_sleep: dongle_i2c_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&dongle_i2c_default>;
    pinctrl-1 = <&dongle_i2c_sleep>;
    pinctrl-names = "default", "sleep";

    oled: oled@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        /* SH1106 has a 132-column RAM; the 128-px panel is centered. */
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
    };
};

/*
 * The dongle has no LEDs, but RGB underglow is a "global" behavior: the
 * central runs it and forwards it to the halves, so the behavior must be
 * compiled into the dongle for the RGB keys (and ZMK Studio) to work. This
 * one-LED strip on P1.02, a pin the nice!nano pinout does not expose, only
 * exists to satisfy the underglow driver.
 */
&pinctrl {
    dongle_dummy_spi_default: dongle_dummy_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 2)>;
        };
    };

    dongle_dummy_spi_sleep: dongle_dummy_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 2)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&dongle_dummy_spi_default>;
    pinctrl-1 = <&dongle_dummy_spi_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <1>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
